# Use this file to test the Debian package created by JPackage
#
# podman build  -f Dockerfile.test -t xremote-proxy .
# podman run --rm -it --name xremote-proxy xremote-proxy
#
# You can login as root with password 'xremote-proxy'

FROM debian:stable

RUN apt-get update && apt-get install -y systemd-sysv procps && apt-get clean && echo 'root:xremote-proxy' | chpasswd

COPY target/xremote-proxy_*.deb /

RUN apt-get install /xremote-proxy_*_$(dpkg --print-architecture).deb; systemctl enable xremote-proxy && rm -f /usr/sbin/policy-rc.d

CMD [ "/sbin/init" ]
